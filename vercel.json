{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/learn-chinese-with-wordle",
      "destination": "/learn-chinese-with-idioms",
      "permanent": true
    },
    {
      "source": "/learn-chinese-with-wordle.html",
      "destination": "/learn-chinese-with-idioms",
      "permanent": true
    },
    {
      "source": "/study/chinese-wordle-hsk-guide",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/study/chinese-wordle-hsk-guide.html",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/answer/:date(2026-04-30|2026-05-0[1-9]|2026-05-10)",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/answer/:date(2026-04-30|2026-05-0[1-9]|2026-05-10)/",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/answer/:date(2026-0[1-4])",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/answer/:date(2026-0[1-4])/",
      "destination": "/study/chinese-idiom-hsk-guide",
      "permanent": true
    },
    {
      "source": "/answer/:date(2027-\d{2}-\d{2})",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/answer/:date(2027-\d{2}-\d{2})/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/answer/:date(2028-\d{2}-\d{2})",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/answer/:date(2028-\d{2}-\d{2})/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
